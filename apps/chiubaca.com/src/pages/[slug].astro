---
import { getCollection, getEntry, render } from "astro:content";
import JournalLayout from "../layouts/JournalLayout.astro";
import PermanentNotePage from "../components/journal/PermanentNotePage.astro";
import { readingTimeMinutes } from "../lib/reading-time";

export async function getStaticPaths() {
  const blogs = await getCollection("permanent-notes");
  return blogs.map((blog) => ({ params: { slug: blog.id } }));
}

const { slug } = Astro.params;
const entry = await getEntry("permanent-notes", slug);
if (!entry) return;

const { Content } = await render(entry);
const { title, description, tags, publish_date, last_updated, status } = entry.data;
const published = publish_date.toISOString();
const updated = last_updated.toISOString();
---

<JournalLayout title={title} description={description || ""} noindex={status === "draft"} type="article">
  <Fragment slot="head">
    <meta name="keywords" content={tags.join(", ")} />
    <meta property="article:published_time" content={published} />
    <meta property="article:modified_time" content={updated} />
    <meta name="author" content="Alex Chiu" />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>
  <PermanentNotePage title={title} description={description} tags={tags} published={published} updated={updated} readingMinutes={readingTimeMinutes(entry.body ?? "")} draft={status === "draft"}>
    <Content />
  </PermanentNotePage>
</JournalLayout>

---
import { getCollection, render, type CollectionEntry } from "astro:content";
import JournalLayout from "../../layouts/JournalLayout.astro";
import FleetingNotePage from "../../components/journal/FleetingNotePage.astro";
import { NOTES_PER_PAGE, notesPageHref, sortFleetingNotes, summariseFleetingNote, noteSourceHref } from "../../lib/fleeting-notes";
import type { FleetingNoteSummary } from "../../components/journal/types";

export async function getStaticPaths() {
  const entries = sortFleetingNotes(await getCollection("fleeting-notes"));
  const summaries = entries.map(summariseFleetingNote);
  return entries.map((entry, index) => ({
    params: { date: entry.id },
    props: {
      entry, note: summaries[index],
      newer: summaries[index - 1] ?? null,
      older: summaries[index + 1] ?? null,
      archiveHref: notesPageHref(Math.floor(index / NOTES_PER_PAGE) + 1),
    },
  }));
}
interface Props {
  entry: CollectionEntry<"fleeting-notes">;
  note: FleetingNoteSummary;
  newer: FleetingNoteSummary | null;
  older: FleetingNoteSummary | null;
  archiveHref: string;
}
const { entry, note, newer, older, archiveHref } = Astro.props;
const { Content } = await render(entry);
---

<JournalLayout title={`${note.title} — fleeting note`} description={note.excerpt || `A page from Alex Chiu’s notebook, ${entry.id}.`} noindex newerHref={newer?.href} olderHref={older?.href}>
  <FleetingNotePage note={note} sourceHref={noteSourceHref(entry.id)} newer={newer} older={older} archiveHref={archiveHref}>
    <Content />
  </FleetingNotePage>
</JournalLayout>

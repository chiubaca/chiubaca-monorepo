---
import { getCollection } from "astro:content";
import JournalLayout from "../../layouts/JournalLayout.astro";
import FleetingNotesIndex from "../../components/journal/FleetingNotesIndex.astro";
import { sortFleetingNotes, paginateFleetingNotes, summariseFleetingNote } from "../../lib/fleeting-notes";

const entries = sortFleetingNotes(await getCollection("fleeting-notes"));
const { notes, pagination } = paginateFleetingNotes(entries);
---

<JournalLayout title="Fleeting notes" description="Small discoveries, half-formed thoughts, and things worth keeping. A record of learning as it happens." olderHref={pagination.olderHref}>
  <FleetingNotesIndex notes={notes.map(summariseFleetingNote)} pagination={pagination} />
</JournalLayout>
